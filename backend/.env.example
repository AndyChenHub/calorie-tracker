# Optional shared token between the iOS app and this companion backend.
# Leave empty for local trusted Wi-Fi development, or set a secret string.
COMPANION_AUTH_TOKEN=

# Optional OAuth client IDs:
# OpenAI Sign in with ChatGPT uses dynamic_agent_client automatically by default!
OPENAI_OAUTH_CLIENT_ID=
# Optional Google Cloud OAuth Desktop/Web Client ID if using Google OAuth PKCE instead of Google AI Studio key:
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional server-side API keys (authorized from console.anthropic.com, platform.openai.com, or aistudio.google.com)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Host and port for the companion server (0.0.0.0 allows your iPhone on Wi-Fi to connect)
HOST=0.0.0.0
PORT=8787
