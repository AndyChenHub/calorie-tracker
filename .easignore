*.key
*.mobileprovision
*.ipa
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env*.local
*.tsbuildinfo
/ios
/android

# Exclude non-mobile directories from EAS cloud archive uploads
/backend
/design-prototype
/.github
.git
