{
  "expo": {
    "name": "Plate",
    "slug": "calorie-tracker",
    "scheme": "calorietracker",
    "version": "1.1.6",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "backgroundColor": "#F5F5F7",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.calorielens.tracker",
      "buildNumber": "8",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Plate uses your camera to take photos of your meals and analyze calories and macros.",
        "NSPhotoLibraryUsageDescription": "Plate accesses your photo library so you can upload meal photos for calorie and macro analysis.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.calorielens.tracker",
      "versionCode": 8,
      "adaptiveIcon": {
        "backgroundColor": "#121216",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Plate uses your camera to take photos of your meals and analyze calories and macros.",
          "recordAudioAndroid": false
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font"
    ],
    "extra": {
      "releaseChannel": "stable",
      "releaseDate": "2026-11-14"
    }
  }
}
